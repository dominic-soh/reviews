{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,

    "module": "node16",
    "moduleResolution": "node16",
    "erasableSyntaxOnly": true,

    // Match Rsbuild v2 runtime requirements.
    "lib": ["es2023"],
    "target": "es2022",

    "noEmit": true
  },
  "include": ["./rsbuild.config.ts", "./rstest.config.ts"]
}
