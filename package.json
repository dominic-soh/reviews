{
  "name": "reviews",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "check": "biome check .",
    "format": "biome format --write .",
    "test": "bun run --filter @reviews/app test && bun run --filter @reviews/api test",
    "typecheck": "bun run --filter '*' typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11"
  }
}
